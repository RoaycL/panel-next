{
  "manifest_version": 3,
  "name": "Panel Next",
  "version": "1.3.0",
  "description": "A self-hosted new-tab dashboard backed by your Panel Next server.",
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "128": "logo.png"
  },
  "key": "",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "minimum_chrome_version": "88"
}
