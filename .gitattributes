# Text and line-ending policy — last reviewed 2026-08-22
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

*.ico binary -eol
*.jpg binary -eol
*.jpeg binary -eol
*.png binary -eol
*.webp binary -eol
*.zip binary -eol

# Preserve downloaded official SVG bytes so provenance SHA-256 stays reproducible.
src/assets/brand-icons/*.svg -text -eol
