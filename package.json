{
  "name": "panel-next",
  "version": "0.0.5",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.13"
  },
  "private": false,
  "description": "Panel Next Web and Chrome new-tab dashboard",
  "author": "BraisedHunter <95302870@qq.com>",
  "keywords": [
    "Panel Next",
    "vue"
  ],
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "build": "run-p add-version type-check build-only",
    "add-version": "node ./add-frontend-version.js",
    "preview": "vite preview",
    "build-only": "pnpm run build:web",
    "build:web": "vite build",
    "bump:extension-version": "node ./scripts/bump-extension-version.mjs",
    "build:extension": "node ./scripts/validate-version.mjs && vite build --mode extension && node ./scripts/validate-extension.mjs",
    "package:extension": "node ./scripts/bump-extension-version.mjs && pnpm run build:extension && node ./scripts/package-extension.mjs",
    "validate:version": "node ./scripts/validate-version.mjs",
    "validate:extension": "node ./scripts/validate-extension.mjs",
    "validate:architecture": "node ./scripts/validate-architecture.mjs",
    "validate:bootstrap-cache": "node ./scripts/validate-bootstrap-snapshot.mjs",
    "validate:dashboard-core": "node ./scripts/validate-dashboard-core.mjs",
    "validate:runtime-navigation": "node ./scripts/validate-runtime-navigation.mjs",
    "validate:lazy-management": "node ./scripts/validate-lazy-management.mjs",
    "validate:status-ui": "node ./scripts/validate-status-ui.mjs",
    "validate:responsive-ui": "node ./scripts/validate-responsive-ui.mjs",
    "validate:widget-registry": "node ./scripts/validate-widget-registry.mjs",
    "validate:offline-sync": "node ./scripts/validate-offline-sync.mjs",
    "validate:repository": "node ./scripts/validate-repository-hygiene.mjs",
    "build:all": "pnpm run validate:version && pnpm run validate:repository && pnpm run validate:architecture && pnpm run validate:bootstrap-cache && pnpm run validate:dashboard-core && pnpm run validate:runtime-navigation && pnpm run validate:lazy-management && pnpm run validate:status-ui && pnpm run validate:responsive-ui && pnpm run validate:widget-registry && pnpm run validate:offline-sync && pnpm run type-check && pnpm run build:web && pnpm run build:extension",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "bootstrap": "pnpm install && pnpm run common:prepare",
    "common:cleanup": "rimraf node_modules && rimraf pnpm-lock.yaml",
    "common:prepare": "husky install"
  },
  "dependencies": {
    "moment": "^2.30.1",
    "naive-ui": "^2.44.1",
    "pinia": "^4.0.2",
    "vue": "^3.5.41",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@iconify/vue": "^5.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.5.4",
    "axios": "^1.19.0",
    "crypto-js": "^4.2.0",
    "eslint": "^10.8.1",
    "fast-glob": "^3.3.3",
    "husky": "^8.0.3",
    "less": "^4.8.1",
    "lint-staged": "^17.3.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.26",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue-tsc": "^3.3.9"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx,vue}": "eslint --fix"
  }
}
